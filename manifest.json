{
  "manifest_version": 3,
  "name": "Intent-Adaptive Screen Reader",
  "version": "1.0.0",
  "description": "Predicts a webpage's task-type and dynamically reorders audio output to prioritize what matters most for that task.",
  "permissions": ["activeTab", "scripting", "storage", "webNavigation"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Intent-Adaptive Screen Reader"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/featureExtractor.js", "src/classifier.js", "src/reorderer.js", "src/speech.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png"
  }
}
